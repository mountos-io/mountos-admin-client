{
  "name": "mountos-admin-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "bun run gen/browser-client.ts",
    "dev": "bun run gen && vite dev --host",
    "build": "bun run gen && vite build",
    "preview": "vite preview",
    "check": "bun run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "proxy": "bun run server/server.ts",
    "dev:all": "bun run gen && concurrently \"vite dev --host\" \"bun run server/server.ts\""
  },
  "dependencies": {
    "@mountos-app/admin-sdk": "^0.23.0",
    "@simplewebauthn/server": "^13.1.1",
    "hono": "^4.7.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.577.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "bits-ui": "^2.11.5",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "yaml": "^2.8.2"
  }
}
