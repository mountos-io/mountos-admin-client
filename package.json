{
  "name": "mountos-admin-client",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "node scripts/gen-notices.ts && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json",
    "check:server": "tsc -p tsconfig.server.json",
    "proxy": "tsx server/server.ts",
    "dev:all": "concurrently \"vite dev --host\" \"tsx server/server.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@mountos-io/admin-sdk": "^1.5.0",
    "@simplewebauthn/server": "^13.3.0",
    "hono": "^4.12.15",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "prom-client": "^15.1.3",
    "undici": "^8.4.1"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.577.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.9.3",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  }
}
