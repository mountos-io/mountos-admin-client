# Local dev requires local TLS certs (run `make setup-certs`).
MOUNTOS_APPSERV_URL=https://appserv.example.com
MOUNTOS_SDK_SIGNING_KEY=base64-encoded-ed25519-private-key
PROVIDER2DASHBOARD_VERIFICATION_KEY=base64-encoded-ed25519-32byte-public-key
DASHBOARD_SIGNING_KEY=base64-encoded-ed25519-32byte-private-seed
DASHBOARD_VERIFICATION_KEY=base64-encoded-ed25519-32byte-public-key
REDIS_URL=redis://localhost:6379
PORT=3001

# WebAuthn (optional overrides, defaults: localhost / http://localhost:5173)
# Local HTTPS setup (one-time):
#   brew install mkcert && mkcert -install
#   make setup-certs
#   echo '127.0.0.1 local.mountos.io' | sudo tee -a /etc/hosts
# WEBAUTHN_RP_ID=local.mountos.io
# WEBAUTHN_RP_NAME=mountOS Dashboard
# WEBAUTHN_ORIGIN=https://local.mountos.io:5173

# Native login extension (optional). Off entirely unless MOUNTOS_PORTAL_DATABASE_URL
# is set — a default deployment without it behaves exactly as above.
# createdb -h localhost -p 5432 -U princejohnwesley mountos_portal
# sslmode=disable for local dev: node-postgres maps require/prefer/verify-ca to full
# cert verification (unlike psql), which fails against a local, non-TLS Postgres.
# MOUNTOS_PORTAL_DATABASE_URL=postgresql://princejohnwesley:jason@localhost:5432/mountos_portal?sslmode=disable
# MOUNTOS_PORTAL_PASSWORD_PEPPER=base64-or-any-long-random-secret
# MOUNTOS_PORTAL_TOTP_ENC_KEY=base64-encoded-32-byte-key   # openssl rand -base64 32
# MOUNTOS_PORTAL_APP_URL=https://local.mountos.io:5173
# EMAIL_PROVIDER=ses
# EMAIL_FROM=no-reply@yourdomain.example   # must be a verified identity with the chosen provider
# EMAIL_SES_REGION=us-west-2   # AWS creds via the standard SDK chain (env/shared config/instance role)
